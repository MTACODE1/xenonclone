<%- include('partials/header', { currentPage: 'staff' }) %>

<div class="page-header">
  <a href="<%= basePath %>/staff" class="btn btn-outlined btn-sm back-button">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to Staff
  </a>
  <h4><%= staff.name %> — Client Access</h4>
  <p><%= staff.mtakpi_staff_name %> &bull; <%= staff.role %></p>
</div>

<div class="card" style="max-width: 500px;">
  <form method="POST" action="<%= basePath %>/staff/<%= staff.id %>/access" class="card-body">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <% orgs.forEach(org => { %>
      <label style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--divider);">
        <input type="checkbox" name="org_ids" value="<%= org.id %>" <%= org.assigned ? 'checked' : '' %>>
        <%= org.name %>
        <span class="text-muted" style="margin-left:auto; font-size:0.75rem;"><%= org.client_ref || '' %></span>
      </label>
    <% }) %>
    <button type="submit" class="btn btn-primary" style="margin-top:16px;">Save Access</button>
  </form>
</div>

<%- include('partials/footer') %>
