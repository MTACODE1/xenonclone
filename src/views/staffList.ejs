<%- include('partials/header', { currentPage: 'staff' }) %>

<%
  const roleLabels = { super_admin: 'Super Admin', admin: 'Admin', staff: 'Staff' };
%>

<div class="page-header">
  <h4>Staff</h4>
  <p>Manage staff accounts and which clients each person can access</p>
</div>

<div class="card">
  <div class="table-filters">
    <input type="text" id="staffSearch" placeholder="Search staff..." class="form-input" style="width: 250px;">
  </div>
  <table class="data-table" id="staffTable">
    <thead>
      <tr>
        <th>Name</th><th>MTAKPI Staff Name</th><th>Role</th><th>Settings Access</th><th>Client Access</th><th>Status</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% staff.forEach(s => { %>
        <tr class="staff-row" data-name="<%= s.name.toLowerCase() %> <%= s.mtakpi_staff_name.toLowerCase() %>">
          <td>
            <span class="chip" style="background:var(--primary-light); color:var(--primary-dark);"><%= s.initials %></span>
            <%= s.name %>
            <% if (s.canManage) { %>
              <form method="POST" action="<%= basePath %>/staff/<%= s.id %>/initials" style="display:inline;" onsubmit="return promptInitials(this, '<%= s.initials %>')">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="initials" value="">
                <button type="submit" class="popover-add-btn" style="margin-left:4px;" title="Edit initials">✎</button>
              </form>
            <% } %>
          </td>
          <td><%= s.mtakpi_staff_name %></td>
          <td>
            <% if (s.canChangeRole) { %>
              <form method="POST" action="<%= basePath %>/staff/<%= s.id %>/role" onchange="this.submit()">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <select name="role" class="form-select" style="padding:4px 6px;">
                  <% assignableRoles.forEach(r => { %>
                    <option value="<%= r %>" <%= s.role === r ? 'selected' : '' %>><%= roleLabels[r] %></option>
                  <% }) %>
                </select>
              </form>
            <% } else { %>
              <%= roleLabels[s.role] %><% if (s.id === myId) { %> <span class="text-muted">(you)</span><% } %>
            <% } %>
          </td>
          <td>
            <% if (s.role === 'staff' && s.canManage) { %>
              <form method="POST" action="<%= basePath %>/staff/<%= s.id %>/settings-access" onchange="this.submit()">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="can_manage_settings" value="<%= s.can_manage_settings ? '0' : '1' %>">
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                  <input type="checkbox" onclick="this.form.requestSubmit()" <%= s.can_manage_settings ? 'checked' : '' %>>
                  <span class="text-muted" style="font-size:0.75rem;">Can edit Settings</span>
                </label>
              </form>
            <% } else if (s.role !== 'staff') { %>
              <span class="text-muted" style="font-size:0.75rem;">Included in role</span>
            <% } else { %>
              <span class="text-muted" style="font-size:0.75rem;"><%= s.can_manage_settings ? 'Yes' : 'No' %></span>
            <% } %>
          </td>
          <td><a href="<%= basePath %>/staff/<%= s.id %>/edit"><%= s.orgCount %> client<%= s.orgCount === 1 ? '' : 's' %></a></td>
          <td>
            <span class="chip <%= s.is_active ? 'chip-success' : 'chip-default' %>"><%= s.is_active ? 'Active' : 'Deactivated' %></span>
          </td>
          <td>
            <a href="<%= basePath %>/staff/<%= s.id %>/edit" class="btn btn-sm btn-outlined">Edit Access</a>
            <% if (s.canManage) { %>
              <form method="POST" action="<%= basePath %>/staff/<%= s.id %>/<%= s.is_active ? 'deactivate' : 'reactivate' %>" style="display:inline;">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outlined"><%= s.is_active ? 'Deactivate' : 'Reactivate' %></button>
              </form>
              <form method="POST" action="<%= basePath %>/staff/<%= s.id %>/delete" style="display:inline;" onsubmit="return confirm('Permanently delete <%= s.name %>? This removes their account and all client-access grants. This cannot be undone.')">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-ghost-error">Delete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
document.getElementById('staffSearch').addEventListener('input', function() {
  const q = this.value.toLowerCase();
  document.querySelectorAll('.staff-row').forEach(row => {
    row.style.display = !q || (row.dataset.name || '').includes(q) ? '' : 'none';
  });
});

function promptInitials(form, current) {
  const next = prompt('New initials (max 3 characters):', current);
  if (!next) return false;
  form.querySelector('[name="initials"]').value = next.trim().toUpperCase().slice(0, 3);
  return true;
}
</script>

<%- include('partials/footer') %>
