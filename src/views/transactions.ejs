<%- include('partials/header', { currentPage: 'transactions' }) %>

<div class="page-header page-header-flex">
  <div>
    <h4>Transaction Counts</h4>
    <p><%= (query.period || 'since_lock_date').replaceAll('_',' ') %>: worked out from each client's last sync. Changing the period needs no new sync; each client's own dates are shown under its name.</p>
  </div>
  <button onclick="exportCSV()" class="btn btn-outlined">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
    </svg>
    Export CSV
  </button>
</div>

<form method="GET" action="<%= basePath %>/transactions" class="form-row mb-24">
  <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Search clients..." class="form-input" style="width: 250px;" oninput="this.form.submit()">

  <select name="period" class="form-select" onchange="handlePeriodChange(this)">
    <% (typeof periodOptions !== 'undefined' && periodOptions ? periodOptions : [
      { value: 'previous_fy', label: 'Previous Financial Year' }, { value: 'current_fy', label: 'Current Financial Year' },
      { value: 'rolling_12_months', label: 'Rolling 12 months' }, { value: 'current_month', label: 'Current Month' },
      { value: 'previous_month', label: 'Previous Month' }, { value: 'since_lock_date', label: 'Since Xero Lock Date' },
      { value: 'custom', label: 'Custom Date Range' }
    ]).forEach(option => { %>
    <option value="<%= option.value %>" <%= query.period===option.value?'selected':'' %><% if (option.title) { %> title="<%= option.title %>"<% } %>><%= option.label %></option>
    <% }) %>
  </select>

  <div id="customDates" class="form-row" style="<%= query.period==='custom' ? 'display: flex;' : 'display: none;' %>">
    <input type="date" name="from" value="<%= query.from||'' %>" class="form-input">
    <span class="text-muted">to</span>
    <input type="date" name="to" value="<%= query.to||'' %>" class="form-input">
  </div>

  <select name="sort" class="form-select" onchange="this.form.submit()">
    <option value="name" <%= (query.sort||'name')==='name'?'selected':'' %>>Business Name A–Z</option>
    <option value="turnover" <%= query.sort==='turnover'?'selected':'' %>>Turnover High–Low</option>
    <option value="transactions" <%= query.sort==='transactions'?'selected':'' %>>Total Transactions High–Low</option>
  </select>
  <button type="submit" class="btn btn-primary">Apply</button>
</form>

<div class="card">
  <div class="table-wrap">
    <table class="data-table" id="txTable">
      <thead>
        <tr>
          <th>Business Name</th>
          <th class="text-right">Turnover</th>
          <th class="text-right">Total Txns</th>
          <th class="text-right">Customer Invoices</th>
          <th class="text-right">Supplier Bills</th>
          <th class="text-right"><span style="cursor: pointer;" onclick="toggleCreditSplit()">Credit Notes ▾</span></th>
          <th class="credit-split text-right" style="display: none; background: var(--primary-light);">└ Sales</th>
          <th class="credit-split text-right" style="display: none; background: var(--primary-light);">└ Purchase</th>
          <th class="text-right"><span style="cursor: pointer;" onclick="toggleBankSplit()" title="Customer payments + supplier payments + direct deposits + direct payments + transfers">Bank Processed ▾</span></th>
          <th class="bank-split text-right" style="display: none; background: var(--primary-light);">└ Customer Payments</th>
          <th class="bank-split text-right" style="display: none; background: var(--primary-light);">└ Supplier Payments</th>
          <th class="bank-split text-right" style="display: none; background: var(--primary-light);">└ Direct Deposits</th>
          <th class="bank-split text-right" style="display: none; background: var(--primary-light);">└ Direct Payments</th>
          <th class="bank-split text-right" style="display: none; background: var(--primary-light);">└ Transfers</th>
          <th class="text-right"><span title="Unreconciled bank statement lines dated in the period, read from Xero by the browser extension, and included in Total Transactions. Where a client's line dates have not been read yet, it shows every unreconciled line (marked 'all dates') and leaves it out of the total.">Bank (Unprocessed)</span></th>
          <th class="text-right"><span title="Posted manual journals">Journals</span></th>
        </tr>
      </thead>
      <tbody id="txBody">
        <% rows.forEach(row => {
          const mth = row.months_covered || 12;
          const fmtGbp = v => v != null ? '£' + Math.round(v).toLocaleString('en-GB') : '—';
          const fmtN = v => v != null ? Number(v).toLocaleString('en-GB') : '—';
          const perMth = (v, m) => v != null ? '(' + Math.round(v/m).toLocaleString('en-GB') + '/mth)' : '';
          const perMthGbp = (v, m) => v != null ? '(£' + Math.round(v/m).toLocaleString('en-GB') + '/mth)' : '';
        %>
        <tr data-name="<%= row.name.toLowerCase() %>">
          <td>
            <a href="<%= basePath %>/client/<%= row.xero_tenant_id %>" class="font-medium"><%= row.name %></a>
            <% if (row.client_ref) { %><div class="text-muted" style="font-size: 0.75rem;"><%= row.client_ref %></div><% } %>
            <% if (row.connection_status === 'disconnected') { %><div class="text-error" style="font-size: 0.75rem;">Disconnected</div><% } %>
            <% if (row.period_start && row.period_end) { %><div class="text-muted" style="font-size: 0.7rem;"><%= (row.period_from || row.period_start).split('-').reverse().join('/') %> to <%= row.period_end.split('-').reverse().join('/') %></div><% } %>
          </td>
          <td class="text-right">
            <% if (row.turnover != null) { %>
              <div class="font-medium"><%= fmtGbp(row.turnover) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMthGbp(row.turnover, mth) %></div>
            <% } else { %><span class="text-muted" title="This client has not been synced since per-day figures were introduced. It fills in at the next nightly sync.">Not synced yet</span><% } %>
          </td>
          <td class="text-right">
            <% if (row.total_transactions != null) { %>
              <div class="font-medium"><%= fmtN(row.total_transactions) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMth(row.total_transactions, mth) %></div>
            <% } else { %>—<% } %>
          </td>
          <td class="text-right">
            <% if (row.customer_invoices != null) { %>
              <div><%= fmtN(row.customer_invoices) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMth(row.customer_invoices, mth) %></div>
            <% } else { %>—<% } %>
          </td>
          <td class="text-right">
            <% if (row.supplier_bills != null) { %>
              <div><%= fmtN(row.supplier_bills) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMth(row.supplier_bills, mth) %></div>
            <% } else { %>—<% } %>
          </td>
          <td class="text-right">
            <% const totalCN = (row.credit_notes_sales||0) + (row.credit_notes_purchase||0); %>
            <% if (row.credit_notes_sales != null) { %>
              <div><%= fmtN(totalCN) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMth(totalCN, mth) %></div>
            <% } else { %>—<% } %>
          </td>
          <td class="credit-split text-right" style="display: none; background: var(--primary-light); font-size: 0.75rem;">
            <div><%= fmtN(row.credit_notes_sales) %></div>
            <div class="text-muted"><%= perMth(row.credit_notes_sales, mth) %></div>
          </td>
          <td class="credit-split text-right" style="display: none; background: var(--primary-light); font-size: 0.75rem;">
            <div><%= fmtN(row.credit_notes_purchase) %></div>
            <div class="text-muted"><%= perMth(row.credit_notes_purchase, mth) %></div>
          </td>
          <td class="text-right">
            <% if (row.bank_processed != null) { %>
              <div><%= fmtN(row.bank_processed) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMth(row.bank_processed, mth) %></div>
            <% } else { %>—<% } %>
          </td>
          <% ['customer_payments', 'supplier_payments', 'direct_deposits', 'direct_payments', 'transfers'].forEach(field => { %>
          <td class="bank-split text-right" style="display: none; background: var(--primary-light); font-size: 0.75rem;">
            <div><%= fmtN(row[field]) %></div>
            <div class="text-muted"><%= perMth(row[field], mth) %></div>
          </td>
          <% }) %>
          <td class="text-right">
            <% if (row.unprocessed_items != null) { %>
              <div style="<%= row.unprocessed_stale ? 'color: var(--text-muted);' : '' %>"><%= fmtN(row.unprocessed_items) %></div>
              <% if (row.unprocessed_dated) { %><div class="text-muted" style="font-size: 0.75rem;"><%= perMth(row.unprocessed_items, mth) %></div><% } %>
              <div class="text-muted" style="font-size: 0.7rem;" title="<%= row.unprocessed_dated ? 'Unreconciled statement lines dated in this period, from the lines read from Xero. Included in Total Transactions.' : 'The dates of the unreconciled lines have not all been read yet, so this is every unreconciled line, whatever its date, and it is not in Total Transactions. Update the client from Xero to read them.' %>"><%= row.unprocessed_stale ? 'old reading, ' : '' %><%= row.unprocessed_dated ? '' : 'all dates, ' %>read <%= row.unprocessed_read_at.slice(0, 10).split('-').reverse().join('/') %></div>
            <% } else { %><span class="text-muted" title="Not read from Xero yet">—</span><% } %>
          </td>
          <% const journalCount = row.manual_journals != null ? row.manual_journals : row.journals; %>
          <td class="text-right">
            <% if (journalCount != null) { %>
              <div><%= fmtN(journalCount) %></div>
              <div class="text-muted" style="font-size: 0.75rem;"><%= perMth(journalCount, mth) %></div>
            <% } else { %>—<% } %>
          </td>
        </tr>
        <% }) %>
        <% if (rows.length === 0) { %>
        <tr><td colspan="16" class="text-center text-muted" style="padding: 48px;">No data — connect and sync clients first.</td></tr>
        <% } %>
      </tbody>
      <% if (rows.length > 0) { %>
      <tfoot style="background: var(--grey-100); border-top: 2px solid var(--divider); font-weight: 600;">
        <tr>
          <td>Totals (<%= rows.length %> clients)</td>
          <td class="text-right">£<%= Math.round(totals.turnover).toLocaleString('en-GB') %></td>
          <td class="text-right"><%= totals.total_transactions.toLocaleString('en-GB') %></td>
          <td class="text-right"><%= totals.customer_invoices.toLocaleString('en-GB') %></td>
          <td class="text-right"><%= totals.supplier_bills.toLocaleString('en-GB') %></td>
          <td class="text-right"><%= (totals.credit_notes_sales + totals.credit_notes_purchase).toLocaleString('en-GB') %></td>
          <td class="credit-split text-right" style="display: none; background: var(--primary-light);"><%= totals.credit_notes_sales.toLocaleString('en-GB') %></td>
          <td class="credit-split text-right" style="display: none; background: var(--primary-light);"><%= totals.credit_notes_purchase.toLocaleString('en-GB') %></td>
          <td class="text-right"><%= totals.bank_processed.toLocaleString('en-GB') %></td>
          <% ['customer_payments', 'supplier_payments', 'direct_deposits', 'direct_payments', 'transfers'].forEach(field => { %>
          <td class="bank-split text-right" style="display: none; background: var(--primary-light);"><%= (totals[field] || 0).toLocaleString('en-GB') %></td>
          <% }) %>
          <td class="text-right"><%= (totals.unprocessed_items || 0).toLocaleString('en-GB') %></td>
          <td class="text-right"><%= totals.journals.toLocaleString('en-GB') %></td>
        </tr>
      </tfoot>
      <% } %>
    </table>
  </div>
</div>

<script>
// Every period applies at once, like the client page; Custom waits for its two dates and the Apply button.
function handlePeriodChange(sel) {
  document.getElementById('customDates').style.display = sel.value === 'custom' ? 'flex' : 'none';
  if (sel.value !== 'custom') sel.form.submit();
}

let creditSplitVisible = false;
function toggleCreditSplit() {
  creditSplitVisible = !creditSplitVisible;
  document.querySelectorAll('.credit-split').forEach(el => {
    el.style.display = creditSplitVisible ? 'table-cell' : 'none';
  });
}

let bankSplitVisible = false;
function toggleBankSplit() {
  bankSplitVisible = !bankSplitVisible;
  document.querySelectorAll('.bank-split').forEach(el => {
    el.style.display = bankSplitVisible ? 'table-cell' : 'none';
  });
}

function exportCSV() {
  const rows = [['Business Name','Ref','Turnover','Total Transactions','Customer Invoices','Supplier Bills','Credit Notes (Sales)','Credit Notes (Purchase)','Bank Processed','Customer Payments','Supplier Payments','Direct Deposits','Direct Payments','Transfers','Bank (Unprocessed)','Journals','Period From','Period To']];
  <% rows.forEach(row => { %>
  rows.push([
    '<%= (row.name||'').replace(/'/g,"\'") %>',
    '<%= row.client_ref||'' %>',
    '<%= row.turnover||0 %>',
    '<%= row.total_transactions||0 %>',
    '<%= row.customer_invoices||0 %>',
    '<%= row.supplier_bills||0 %>',
    '<%= row.credit_notes_sales||0 %>',
    '<%= row.credit_notes_purchase||0 %>',
    '<%= row.bank_processed||0 %>',
    '<%= row.customer_payments||0 %>',
    '<%= row.supplier_payments||0 %>',
    '<%= row.direct_deposits||0 %>',
    '<%= row.direct_payments||0 %>',
    '<%= row.transfers||0 %>',
    '<%= row.unprocessed_items != null ? row.unprocessed_items : '' %>',
    '<%= (row.manual_journals != null ? row.manual_journals : row.journals)||0 %>',
    '<%= row.period_from||row.period_start||'' %>',
    '<%= row.period_end||'' %>'
  ]);
  <% }) %>
  const csv = rows.map(r => r.map(v => '"' + String(v).replace(/"/g,'""') + '"').join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'transaction-counts.csv';
  a.click();
}
</script>

<%- include('partials/footer') %>
