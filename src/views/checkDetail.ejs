<%- include('partials/header', { currentPage: 'client' }) %>
<%
const orgIdentifier = org.xero_tenant_id || org.freeagent_company_id;
// While another period is on screen (a "period view"), every link and form here carries that period so paging,
// filtering, exporting and reviewing stay in it. Empty for the client's normal period.
const viewQs = typeof viewQuery === 'undefined' ? '' : (viewQuery || '');
const viewAmp = viewQs ? '&' + viewQs : '';
const viewFields = viewQs ? [...new URLSearchParams(viewQs)] : [];
const viewInfo = typeof periodView === 'undefined' ? null : periodView;
// Finding values store dates as plain YYYY-MM-DD strings (toDateString() throughout the app) —
// reformat to UK DD/MM/YYYY for display without touching the underlying data or any other check
// that reads these same fields.
const ISO_DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
function fmtDisplayDate(val) {
  if (typeof val !== 'string') return val;
  // A sentence (it has spaces) can name dates too, e.g. the dividend check's "between 2026-11-01 and 2026-11-24".
  // A reference without spaces (INV-2026-11-01) is left exactly as written.
  if (!ISO_DATE_RE.test(val)) return val.includes(' ') ? val.replace(/\b(\d{4})-(\d{2})-(\d{2})\b/g, '$3/$2/$1') : val;
  const [y, m, d] = val.split('-');
  return `${d}/${m}/${y}`;
}
// Money is shown in the client's currency ("£" for GBP, "AED " for a client kept in AED; the page only labels
// amounts, see rowPrefix below for documents in another currency) with pence whatever its value: a whole-pound amount is stored as a plain integer (22, 1188),
// which used to be shown bare. Decided by the column name, so counts (items to reconcile, days) stay plain numbers.
const MONEY_KEY_RE = /(amount|total|value|balance|gross|net|spent|received|difference|outstanding|due)(gbp)?$/i;
const NOT_MONEY_KEY_RE = /(date|days|count|items|lines|age|code|number|rate|percent)/i;
function isMoneyCell(key, val) {
  if (typeof val !== 'number' || !Number.isFinite(val)) return false;
  if (!Number.isInteger(val)) return true;
  return MONEY_KEY_RE.test(String(key)) && !NOT_MONEY_KEY_RE.test(String(key));
}
const cur = currencyPrefix(locals.clientCurrency);
function fmtMoney(val, prefix = cur) {
  return (val < 0 ? '-' + prefix : prefix) + Math.abs(val).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
// A row for a document raised in another currency carries that currency ("currency": "USD"), and its
// figures are in it. Its amounts take that code, so a dollar figure is never labelled as the client's
// own currency. Rows without the field are in the client's currency, as before.
// Zoho, QuickBooks and FreeAgent rows also say how the document went into the totals: "baseAmount" is
// the figure converted to the client's currency (shown as "USD 1,000.00 = AED 3,672.50"), and
// "noExchangeRate" means the ledger gave no usable rate, so it is listed but left out of the totals.
// A row in another currency with neither (Xero's rows; FreeAgent's, which map no rate; a re-run before the
// client's currency is stored) keeps the "(not converted)" wording.
function rowPrefix(item) {
  return item && item.currency ? currencyPrefix(item.currency) : cur;
}
function isOtherCurrency(item) {
  return rowPrefix(item) !== cur;
}
function isConvertedRow(item) {
  return isOtherCurrency(item) && typeof item.baseAmount === 'number' && Number.isFinite(item.baseAmount);
}
function isNoRateRow(item) {
  return isOtherCurrency(item) && item.noExchangeRate === true;
}
%>

<% if (viewInfo) { %>
<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px;background:#ECF2FF;border:1px solid #C9D8FF;color:#2A3547;border-radius:10px;padding:10px 14px;font-size:0.85rem;">
  <span><strong>Viewing <%= viewInfo.label %>.</strong> The client's normal results (<%= viewInfo.normalLabel %>) are unchanged.</span>
  <a class="btn btn-outlined btn-sm" href="?status=<%= status %>">Back to the normal period</a>
</div>
<% } %>
<nav class="breadcrumb">
  <a href="<%= basePath %>/">Home</a>
  <span>/</span>
  <a href="<%= basePath %>/client/<%= orgIdentifier %>"><%= org.name %></a>
  <span>/</span>
  <span class="breadcrumb-current"><%= def ? def.label : checkType %></span>
</nav>

<div class="page-header check-header">
  <a href="<%= basePath %>/client/<%= orgIdentifier %><%= viewQs ? '?' + viewQs : '' %>" class="btn btn-outlined btn-sm back-button">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to issues
  </a>
  <div class="check-header-main">
    <h4><%= def ? def.label : checkType %>
      <% if (def && def.importance) { %><span class="chip chip-<%= def.importance %>"><%= def.importance.charAt(0).toUpperCase() + def.importance.slice(1) %></span><% } %>
    </h4>
    <% const notApplicableReasons = {
         not_a_company: checkType === 'dividend_status'
           ? 'dividends only apply to a limited company (this client is an LLP, partnership, sole trader or non-UK)'
           : 'only applies to UK limited companies (this client is a sole trader, partnership or non-UK)',
         no_filed_accounts_yet: 'this company has not filed any accounts at Companies House yet',
         flat_rate_scheme: 'this client is on the VAT Flat Rate Scheme, so VAT on purchases is not reclaimed',
         not_vat_registered: 'this client is not VAT registered',
         not_applicable_uae: { dividend_status: 'a UK check: UAE dividends carry no withholding tax and need no filing',
           sales_tax_on_bills: 'a UAE company uses the same VAT rates for sales and purchases',
           purchase_tax_on_invoices: 'a UAE company uses the same VAT rates for sales and purchases' }[checkType]
           || 'this check is UK-specific and does not apply to a UAE company',
         ...Object.fromEntries([['freeagent', 'FreeAgent'], ['quickbooks', 'QuickBooks'], ['zoho', 'Zoho Books']].map(([key, name]) => [
           `not_applicable_${key}`,
           { old_purchase_credits: `${name} has no supplier credit notes`,
             contact_defaults: `${name} contacts have no default account or tax code`,
             unapproved_invoices: `${name} has no draft invoices`,
             unapproved_bills: `${name} has no draft bills`,
             unexpected_account_used: `${name} contacts have no default account to compare with`,
             unexpected_tax_code_used: `${name} contacts have no default tax rate to compare with`,
             sales_tax_on_bills: `${name} tax rates are not split into sales and purchase rates`,
             purchase_tax_on_invoices: `${name} tax rates are not split into sales and purchase rates`,
             vat_scheme_threshold: `${name} does not say which VAT scheme the client uses` }[checkType] || `${name} does not have this`,
         ])),
       }; %>
    <% if (issue && typeof displayStatus !== 'undefined' && displayStatus === 'not_applicable') { %>
      <div class="check-stats">
        <div class="check-stat"><strong>Not applicable</strong><span><%= notApplicableReasons[issue.period_checked] || 'not applicable to this client' %></span></div>
      </div>
    <% } else if (issue && (['unavailable_zoho', 'needs_zoho_bank_access', 'needs_zoho_expense_access'].includes(issue.period_checked) || (issue.period_checked === 'needs_sync' && /^zoho-/.test(String(org.freeagent_company_id || ''))))) { %><%# Zoho Books: why there is no result, instead of "null issues found". %>
      <div class="check-stats">
        <div class="check-stat"><strong><%= issue.period_checked === 'unavailable_zoho' ? 'Unavailable' : issue.period_checked === 'needs_sync' ? 'Needs sync' : 'Reconnect Zoho Books' %></strong><span><%= issue.period_checked === 'unavailable_zoho' ? "Zoho Books' API does not give the data this check needs" : issue.period_checked === 'needs_sync' ? 'the data this check needs has not been read from Zoho Books yet: it is read at the next sync' : issue.period_checked === 'needs_zoho_bank_access' ? 'the Zoho Books connection does not allow bank access: reconnect Zoho Books, or read the Banking page with the extension' : 'the Zoho Books connection does not allow expense access: reconnect Zoho Books' %></span></div>
      </div>
    <% } else if (issue) { %>
      <div class="check-stats">
        <div class="check-stat"><strong class="text-warning"><%= issue.count %></strong><span>issue<%= issue.count !== 1 ? 's' : '' %> found</span></div>
        <% if (typeof zohoUnreconciled !== 'undefined' && zohoUnreconciled) { %><%# Zoho Books Unreconciled Bank: Zoho's own total, money in minus money out (signed); the gross is in the note below. Zoho's report gives it per account, so with several accounts each has its own figure and the combined one is only in the note, labelled. %>
          <% if (zohoUnreconciled.accounts.length > 1) { %><% zohoUnreconciled.accounts.forEach(function (a) { %>
          <div class="check-stat"><strong class="text-error"><%= fmtMoney(a.net) %></strong><span>net unmatched value, <%= a.account || 'Unnamed account' %></span></div>
          <% }) %><% } else { %>
          <div class="check-stat"><strong class="text-error"><%= fmtMoney(zohoUnreconciled.net) %></strong><span>net unmatched value (money in minus money out)</span></div>
          <% } %>
        <% } else if (issue.potential_value_gbp > 0) { %>
          <div class="check-stat"><strong class="text-error"><%= cur %><%= Number(issue.potential_value_gbp).toLocaleString('en-GB',{minimumFractionDigits:2,maximumFractionDigits:2}) %></strong><span>potential value</span></div>
        <% } %>
        <% if (issue.period_checked) { %>
          <div class="check-stat"><strong><%= (typeof periodCheckedLabel !== 'undefined' && periodCheckedLabel) || issue.period_checked.replace(/_/g, ' ') %></strong><span>period checked</span></div>
        <% } %>
      </div><% if (typeof zohoUnreconciled !== 'undefined' && zohoUnreconciled) { %>
      <p class="check-note"><% if (zohoUnreconciled.accounts.length > 1) { %>Per account, as Zoho Books' Reconciliation Status report gives it: <%= zohoUnreconciled.accounts.map(a => `${a.account || 'Unnamed account'}: ${a.count} transaction${a.count === 1 ? '' : 's'}, money in ${fmtMoney(a.moneyIn)} minus money out ${fmtMoney(a.moneyOut)} = ${fmtMoney(a.net)}`).join('; ') %>. All accounts combined: <% } else { %>As Zoho Books' Reconciliation Status report adds them up: <% } %>money in <%= fmtMoney(zohoUnreconciled.moneyIn) %> minus money out <%= fmtMoney(zohoUnreconciled.moneyOut) %> = <%= fmtMoney(zohoUnreconciled.net) %> over <%= zohoUnreconciled.count %> transaction<%= zohoUnreconciled.count === 1 ? '' : 's' %> (gross, money in plus money out: <%= fmtMoney(zohoUnreconciled.gross) %>, the value used for the score).<% if (zohoUnreconciled.otherCurrency) { %> <%= zohoUnreconciled.otherCurrency %> transaction<%= zohoUnreconciled.otherCurrency === 1 ? '' : 's' %> in another currency <%= zohoUnreconciled.otherCurrency === 1 ? 'is' : 'are' %> listed but not added to these figures.<% } %></p><% } %>
      <% if (issue.potential_value_gbp > 0 && (checkType === 'multi_account_suppliers' || checkType === 'multi_tax_suppliers')) { %>
        <p class="check-note">Value counts only the amount outside each supplier's main <%= checkType === 'multi_account_suppliers' ? 'account code' : 'tax code' %>, not the supplier's full total.</p>
      <% } %>
    <% } %><% if (typeof zohoUnreadNote !== 'undefined' && zohoUnreadNote) { %><p class="check-note"><%= zohoUnreadNote %></p><% } %>
  </div>
</div>

<%
  const detailDesc = (typeof checkDescriptions !== 'undefined' ? checkDescriptions : {})[checkType] || {};
%>
<% if (detailDesc.issue) { %>
<details class="card about-check">
  <summary>
    <span class="about-title">About this check</span>
    <span class="about-teaser"><%= String(detailDesc.issue).length > 150 ? String(detailDesc.issue).slice(0, 149).trimEnd() + '…' : detailDesc.issue %></span>
  </summary>
  <div class="about-body">
    <div class="desc-row">
      <span class="chip" style="flex-shrink: 0; margin-top: 2px; background: var(--mta-dark-blue); color: white;">Issue</span>
      <p><%= detailDesc.issue %></p>
    </div>
    <div class="desc-row">
      <span class="chip" style="flex-shrink: 0; margin-top: 2px; background: var(--success); color: white;">So What?</span>
      <p><%= detailDesc.soWhat %></p>
    </div>
    <div class="desc-row">
      <span class="chip" style="flex-shrink: 0; margin-top: 2px; background: var(--mta-dark-blue); color: white;">Solution</span>
      <p><%= detailDesc.solution %></p>
    </div>
  </div>
</details>
<% } %>

<% if (checkType === 'bank_balance') { %>
<%
  // One record per bank account, built by bankEvidence.js — the same function that calculated the check, so
  // the figures and differences here always match the dashboard.
  const allAccounts = typeof bankAccounts === 'undefined' ? [] : bankAccounts;
  const reading = typeof bankReading === 'undefined' ? null : bankReading;
  let closingDateStr = null;
  if (issue && issue.period_checked) {
    const m = issue.period_checked.match(/(\d{4}-\d{2}-\d{2})$/);
    if (m) closingDateStr = new Date(m[1]).toLocaleDateString('en-GB', { day:'2-digit', month:'2-digit', year:'numeric' });
  }
  function fmtBal(val) {
    if (val == null) return null;
    const n = Number(val);
    const abs = Math.abs(n).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return (n < 0 ? '-' + cur : cur) + abs;
  }
  // The active finding for each account, so "Mark as OK" marks that account's difference OK for this period.
  const findingKeyByAccount = {};
  const noteByAccount = {};
  (items || []).forEach(item => {
    if (item.accountId && item.finding_key) { findingKeyByAccount[item.accountId] = item.finding_key; noteByAccount[item.accountId] = item.standaloneNote || ''; }
  });
  const readText = reading && reading.readAt
    ? new Date(reading.readAt).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + (reading.readByName ? ' by ' + reading.readByName : '')
    : null;
%>

<%# Issue/So What?/Solution boxes %>
<div class="card bb-description-card">
  <div class="desc-row"><span class="chip" style="flex-shrink:0;background:var(--mta-dark-blue);color:white;">Issue</span><p>Bank accounts whose balance in Xero doesn't match the bank feed (or an external bank statement).</p></div>
  <div class="desc-row"><span class="chip" style="flex-shrink:0;background:var(--success);color:white;">So What?</span><p>Bookkeeping is incomplete and does not currently reflect all of the bank transactions going through the business bank accounts.</p></div>
  <div class="desc-row"><span class="chip" style="flex-shrink:0;background:var(--mta-dark-blue);color:white;">Solution</span><p>Review the bank feed in Xero and process outstanding items. If the difference is due to uncleared items, use the "Mark as OK" button.</p></div>
</div>

<div class="card" style="padding:12px 16px;margin-bottom:12px;font-size:0.82rem;color:#5A6A85;">
  <% if (!reading) { %>
    Xero's Bank accounts page has not been read for this client yet. <a href="<%= basePath %>/client/<%= orgIdentifier %>#bank-screen">Update from Xero</a> to fill in the bank feed balances.
  <% } else if (!reading.usable) { %>
    <strong style="color:#B42318;">The last reading of Xero's Bank accounts page is more than 7 days old</strong> (<%= readText %>), so it is not used. <a href="<%= basePath %>/client/<%= orgIdentifier %>#bank-screen">Update from Xero</a>.
  <% } else { %>
    "Per Xero Statement" and the Xero balance come from Xero's Bank accounts page, read <%= readText %>. <a href="<%= basePath %>/client/<%= orgIdentifier %>#bank-screen">Update from Xero</a>.
  <% } %>
  A closing balance from an imported statement or typed in below takes priority over the bank feed.
</div>

<%# Show-all toggle: like Xenon, accounts that agree are hidden until asked for %>
<div class="bb-show-all-row">
  <label class="toggle-switch" style="gap:10px;">
    <input type="checkbox" id="bbShowAll" onchange="toggleBbShowAll(this.checked)">
    <span class="toggle-slider"></span>
    <span style="font-size:0.875rem;">Show all bank accounts (allows you to compare statement value for all bank accounts)</span>
  </label>
</div>

<%# Bank account cards grid %>
<div class="bb-cards-grid" id="bbCardsGrid">
<% allAccounts.forEach(acc => {
  const diffOk = acc.difference != null && !acc.hasDifference;
  const known = acc.difference != null;
  const hideByDefault = diffOk || acc.excluded;
%>
<div class="bb-account-card <%= diffOk ? 'bb-card-ok' : '' %>" data-has-disc="<%= hideByDefault ? '0' : '1' %>" data-account-id="<%= acc.accountId %>" <% if (hideByDefault) { %>style="display:none;"<% } %>>
  <% if (acc.canEdit) { %>
  <form method="POST" action="<%= basePath %>/client/<%= orgIdentifier %>/bank-account-exclusion" style="position:absolute;top:10px;right:10px;">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <input type="hidden" name="bank_account_id" value="<%= acc.accountId %>">
    <input type="hidden" name="excluded" value="<%= acc.excluded ? '0' : '1' %>">
    <button type="submit" class="bb-exclude-btn" title="<%= acc.excluded ? 'Include in checks' : 'Exclude from checks' %>">×</button>
  </form>
  <% } %>

  <h5 class="bb-account-name"><%= acc.name %></h5>
  <p class="bb-closing-label">Closing Balance<% if (closingDateStr) { %> at <%= closingDateStr %><% } %></p>
  <% if (acc.stoppedImporting || acc.feedProblem) { %>
    <p style="font-size:0.72rem;color:#B42318;margin:0 0 6px;font-weight:600;"><%= acc.stoppedImporting ? 'Bank feed has stopped importing' : 'Xero reports a problem with this bank feed' %></p>
  <% } %>

  <div class="bb-balance-row">
    <span class="bb-balance-label">Per Bank Statement <span class="bb-help" title="A closing balance from an imported bank statement, or typed in here. Optional: when there is one it is used instead of the bank feed.">?</span></span>
    <% if (acc.bankStatementBalance != null) { %>
      <span class="bb-balance-value"><%= fmtBal(acc.bankStatementBalance) %></span>
    <% } else if (acc.canEdit) { %>
      <button type="button" class="bb-click-to-add" onclick="toggleBbAddForm('<%= acc.accountId %>')">Click to add balance</button>
    <% } else { %>
      <span class="bb-balance-value">—</span>
    <% } %>
  </div>

  <% if (acc.canEdit) { %>
  <div id="bb-<%= acc.bankStatementBalance == null ? 'add' : 'edit' %>-form-<%= acc.accountId %>" style="display:none;margin:4px 0 8px;">
    <form method="POST" action="<%= basePath %>/client/<%= orgIdentifier %>/bank-reconciliation" style="display:flex;gap:6px;align-items:center;">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="bank_account_id" value="<%= acc.accountId %>">
      <input type="number" step="0.01" name="statement_balance" value="<%= acc.bankStatementBalance != null ? acc.bankStatementBalance : '' %>" class="form-input" style="flex:1;padding:5px 8px;font-size:0.82rem;" placeholder="Enter closing balance">
      <button type="submit" class="btn btn-primary btn-sm">Save</button>
      <button type="button" class="btn btn-outlined btn-sm" onclick="toggleBb<%= acc.bankStatementBalance == null ? 'Add' : 'Edit' %>Form('<%= acc.accountId %>')">Cancel</button>
    </form>
  </div>
  <% } %>

  <div class="bb-balance-row">
    <span class="bb-balance-label">Per Xero Statement <span class="bb-help" title="The statement balance Xero's bank feed shows on its Bank accounts page<%= acc.xeroStatementDateLabel ? ' (' + acc.xeroStatementDateLabel + ', as Xero shows it, without a year)' : '' %>.">?</span></span>
    <span class="bb-balance-value"><%= fmtBal(acc.xeroStatementBalance) || '—' %><% if (acc.xeroStatementBalance != null && acc.xeroStatementDateLabel) { %> <span style="font-size:0.7rem;color:var(--text-muted);">(<%= acc.xeroStatementDateLabel %>)</span><% } %></span>
  </div>
  <div class="bb-balance-row">
    <span class="bb-balance-label"><strong>Per Xero TB</strong></span>
    <span class="bb-balance-value"><strong><%= fmtBal(acc.xeroBalance) || '—' %></strong></span>
  </div>
  <div class="bb-balance-row">
    <span class="bb-balance-label" style="color:<%= diffOk ? 'var(--success)' : (known ? 'var(--error)' : 'inherit') %>;font-weight:600;">Difference</span>
    <span class="bb-balance-value" style="color:<%= diffOk ? 'var(--success)' : (known ? 'var(--error)' : 'inherit') %>;font-weight:600;"><%= known ? fmtBal(acc.difference) : '—' %></span>
  </div>

  <p style="font-size:0.7rem;color:var(--text-muted);margin:6px 0 10px;">
    <% if (acc.evidenceSource) { %>Compared using: <%= acc.evidenceSource %><% if (acc.xeroBalanceSource !== 'Xero Bank accounts screen' && acc.xeroBalanceAsOf) { %>; Xero balance as of <%= fmtDisplayDate(acc.xeroBalanceAsOf) %><% } %><% } else { %>No closing balance to compare yet<% } %>
  </p>

  <a href="<%= basePath %>/client/<%= orgIdentifier %>#statement-evidence" class="bb-upload-link">Upload Supporting Documents</a>

  <div class="bb-action-row">
    <a href="<%= basePath %>/client/<%= orgIdentifier %>#bank-screen" class="btn btn-primary btn-sm" style="background:#16a34a;border-color:#16a34a;min-width:90px;">Process</a>
    <% if (acc.canEdit && acc.bankStatementBalance != null) { %>
      <button type="button" class="btn btn-outlined btn-sm" onclick="toggleBbEditForm('<%= acc.accountId %>')">Edit Balance</button>
    <% } %>
  </div>
  <% if (findingKeyByAccount[acc.accountId]) { %>
  <form method="POST" action="<%= basePath %>/client/<%= orgIdentifier %>/check/bank_balance/review" style="margin-top:8px;">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
<% viewFields.forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
    <input type="hidden" name="finding_key" value="<%= findingKeyByAccount[acc.accountId] %>">
    <input type="hidden" name="action" value="ok">
    <input type="hidden" name="return_status" value="active">
    <button type="submit" class="btn btn-outlined btn-sm" style="width:100%;text-align:center;border-color:#16a34a;color:#16a34a;">Mark as "OK"</button>
  </form>
  <%# A note against this account's difference; it stays with the account from one sync to the next. %>
  <% if (noteByAccount[acc.accountId]) { %><p style="font-size:0.78rem;color:#5A6A85;margin:8px 0 0;background:#F8FAFC;border-radius:6px;padding:6px 8px;"><strong>Note:</strong> <%= noteByAccount[acc.accountId] %></p><% } %>
  <form method="POST" action="<%= basePath %>/client/<%= orgIdentifier %>/check/bank_balance/note" style="margin-top:6px;display:flex;gap:6px;">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
<% viewFields.forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
    <input type="hidden" name="finding_key" value="<%= findingKeyByAccount[acc.accountId] %>">
    <input type="hidden" name="return_status" value="active">
    <input type="text" name="notes" maxlength="500" placeholder="Add a note" value="<%= noteByAccount[acc.accountId] || '' %>" class="form-input" style="flex:1;min-width:0;padding:5px 8px;font-size:0.78rem;">
    <button type="submit" class="btn btn-outlined btn-sm"><%= noteByAccount[acc.accountId] ? 'Save' : 'Add Note' %></button>
  </form>
  <% } %>
  <% if (acc.excluded) { %><div style="margin-top:6px;font-size:0.75rem;color:var(--text-muted);text-align:center;">Excluded from checks</div><% } %>
</div>
<% }) %>
<% if (!allAccounts.length) { %>
  <div class="empty-state" style="grid-column:1/-1;"><p>No bank accounts found — sync this client, or update it from Xero.</p></div>
<% } else if (!allAccounts.some(acc => !(acc.difference != null && !acc.hasDifference) && !acc.excluded)) { %>
  <div class="empty-state" id="bbAllAgree" style="grid-column:1/-1;"><p>Every bank account agrees with its bank feed. Tick "Show all bank accounts" to see them.</p></div>
<% } %>
</div>

<script>
function toggleBbShowAll(show) {
  document.querySelectorAll('.bb-account-card').forEach(card => {
    if (!show && card.dataset.hasDisc === '0') card.style.display = 'none';
    else card.style.display = '';
  });
}
function toggleBbAddForm(id) {
  const form = document.getElementById('bb-add-form-' + id);
  if (form) form.style.display = form.style.display === 'none' ? '' : 'none';
}
function toggleBbEditForm(id) {
  const form = document.getElementById('bb-edit-form-' + id);
  if (form) form.style.display = form.style.display === 'none' ? '' : 'none';
}
</script>

<% } else { %>

<div class="card">
  <div class="table-filters">
    <% [
      ['active', 'Active', summary.active],
      ['dismissed', 'Dismissed', summary.dismissed],
      ['ignored', 'Ignored', summary.ignored],
      ['ok', 'Marked OK', summary.ok],
      ['all', 'All', summary.active + summary.dismissed + summary.ignored + summary.ok]
    ].forEach(([key, label, count]) => { %>
      <a class="btn btn-sm <%= status === key ? 'btn-primary' : 'btn-outlined' %>"
         href="?status=<%= key %><%= contact ? '&contact=' + encodeURIComponent(contact) : '' %><%= viewAmp %>"><%= label %> (<%= count %>)</a>
    <% }) %>
    <form method="get" style="display:inline-flex;gap:6px;margin-left:auto;align-items:center;">
      <% viewFields.forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
      <input type="hidden" name="status" value="<%= status %>">
      <input class="form-input" type="search" name="contact" value="<%= contact %>" maxlength="100" placeholder="Filter by contact" style="width:200px;">
      <button type="submit" class="btn btn-sm btn-outlined">Filter</button>
      <% if (contact) { %><a class="btn btn-sm btn-outlined" href="?status=<%= status %><%= viewAmp %>">Clear</a><% } %>
    </form>
  </div>
  <%
    // Rows from the 3 months before the review period: listed after the period's own findings, under their own
    // heading, and never counted (they are stored display-only).
    const previousRows = typeof previousItems === 'undefined' ? [] : previousItems;
    const previousPage = typeof previousPagination === 'undefined' ? null : previousPagination;
    const tableRows = [...(items || []), ...previousRows];
  %>
  <% if (!tableRows.length) { %>
    <div class="empty-state">
      <p>No <%= status === 'active' ? 'active' : status %> findings for this check.</p>
    </div>
  <% } else { %>
    <% if (!items || !items.length) { %>
      <div class="empty-state" style="padding:12px 20px;">
        <p>No <%= status === 'active' ? 'active' : status %> findings in the review period. The previous 3 months are listed below for context.</p>
      </div>
    <% } %>
    <%
      // Bank-sourced findings (sales_tax_on_bills/purchase_tax_on_invoices) are already stored as
      // display-only context (see withDisplayOnlyBankFindings in checkRules.js — they never count
      // toward this check's headline count/value/score); this is purely a client-side visibility
      // toggle for rows already present in the page, matching Xenon's own "Show bank
      // payments/deposits too" toggle, which defaults to off.
      const hasDisplayOnlyRows = items.some(item => item.displayOnly);
    %>
    <% if (hasDisplayOnlyRows) { %>
      <div class="table-filters">
        <label style="display:flex;align-items:center;gap:6px;font-size:0.85rem;cursor:pointer;">
          <input type="checkbox" id="showDisplayOnly" onchange="document.querySelectorAll('.display-only-row').forEach(row => row.style.display = this.checked ? '' : 'none')">
          Show bank payments/deposits too
        </label>
      </div>
    <% } %>
    <form id="bulkReview" method="post" action="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/review"></form>
    <% if (status === 'active' && pagination.total > 0) { %>
      <form id="bulkAll" method="post" action="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/review"></form>
      <div class="table-filters">
        <input form="bulkAll" type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <% viewFields.forEach(([name, value]) => { %><input form="bulkAll" type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
        <input form="bulkAll" type="hidden" name="return_status" value="<%= status %>">
        <input form="bulkAll" type="hidden" name="return_page" value="1">
        <input form="bulkAll" type="hidden" name="select_all" value="1">
        <input form="bulkAll" type="hidden" name="action" id="bulkAllAction" value="ignored">
        <!-- Applies to every active finding for this check, not just the current page — matches
             Xenon's own "Ignore/Dismiss all N items" buttons, which state the full count. One
             dropdown + Apply replaces two separate buttons to keep this row compact. -->
        <select id="bulkAllSelect" class="form-input" style="width:auto;" onchange="document.getElementById('bulkAllAction').value=this.value">
          <option value="ignored">Ignore all <%= pagination.total %> items (30 Days)</option>
          <option value="dismissed">Dismiss all <%= pagination.total %> items</option>
        </select>
        <button form="bulkAll" type="submit" class="btn btn-sm btn-outlined" onclick="return confirmBulkAll()">Apply</button>
      </div>
    <% } %>
    <div class="table-filters">
      <input form="bulkReview" type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <% viewFields.forEach(([name, value]) => { %><input form="bulkReview" type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
      <input form="bulkReview" type="hidden" name="return_status" value="<%= status %>">
      <input form="bulkReview" type="hidden" name="return_page" value="<%= pagination.page %>">
      <a class="btn btn-sm btn-outlined" href="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/export.csv?status=<%= status %><%= contact ? '&contact=' + encodeURIComponent(contact) : '' %><%= viewAmp %>">Export CSV</a>
      <button type="button" class="btn btn-sm btn-outlined" id="selectPageBtn" onclick="toggleSelectPage(this)">Select page</button>
      <select form="bulkReview" name="action" class="form-input" style="width:auto;">
        <option value="dismissed">Dismiss</option>
        <option value="ignored">Ignore 30 days</option>
        <option value="ok">Mark OK this period</option>
        <% if (status !== 'active') { %>
          <option value="restore">Restore</option>
        <% } %>
      </select>
      <button form="bulkReview" type="submit" class="btn btn-sm btn-outlined">Apply</button>
      <input form="bulkReview" class="form-input" name="notes" maxlength="500" placeholder="Optional note">
    </div>
    <%
      // Raw Xero GUIDs exist on findings only to build the "Open in Xero" links (see xeroLinks in
      // src/routes/client.js) — they're not meant as a user-facing column alongside the friendly
      // name/description fields that already carry the same information.
      const hiddenColumns = new Set([
        'finding_key', 'review_state', 'ignored_until', 'notes', 'displayOnly', 'xero_links', 'lookback', 'inPeriod',
        'contactId', 'contactID', 'invoiceId', 'invoiceID', 'bankTransactionId', 'bankTransactionID',
        'paymentId', 'paymentID', 'creditNoteId', 'creditNoteID', 'id1', 'id2', 'id', 'documentIds', 'batchPaymentId', 'partCount', 'linkId', 'linkType',
        // 'id' is the same kind of raw Xero GUID as the others above (see xeroLinks in
        // src/routes/client.js, where it's used as a fallback for the invoice/bill/credit-note
        // link) — old_unpaid_invoices/old_sales_credits/old_unpaid_bills/old_purchase_credits (and
        // others) already show the friendly "number" and "contact" fields alongside it, so the raw
        // id added nothing but noise.
        'transactions', // rendered as its own expandable drill-down row below, not a plain column
        // Combined into one colored "Account" badge and one colored transaction-type badge below,
        // instead of two-plus plain-text columns — same treatment for every check that carries
        // these fields (most of the 29: misallocated_items, purchase_tax_missing,
        // unexpected_account_used, etc.), not just the two with a drill-down.
        'accountCode', 'accountName', 'source',
        'ageDays', // rendered as a dedicated "Age" column instead of the generic "age Days" label
        'standaloneNote', // rendered inline under the Review actions, not as its own column
        // Unprocessed Bank rows from Xero's Bank accounts page: ids and raw provenance; "lastRead" shows it readably.
        'bankAccountId', 'batchId', 'readAt', 'readByName', 'potentialValue',
        // A foreign document's converted figure and "no rate" flag: shown inside the amount cell instead.
        'baseAmount', 'noExchangeRate',
      ]);
      // Per-transaction column set for the drill-down (multi_account_suppliers/multi_tax_suppliers)
      // — same hidden-ID-field rule as the main table, applied to each transaction sub-object.
      // lineKey/ok/notes are rendered specially below (the per-line review form); accountCode/
      // accountName are combined into one colored "Account" badge column instead of two plain ones.
      const transactionHiddenColumns = new Set([...hiddenColumns, 'xero_links', 'lineKey', 'ok', 'accountCode', 'accountName', 'source', 'inPeriod', 'type']);
      // Taken from the first row that has transactions: on Unreconciled Bank only batch payments carry them.
      const firstWithTransactions = tableRows.find(row => row.transactions?.length);
      const transactionColumns = firstWithTransactions
        ? Object.keys(firstWithTransactions.transactions[0]).filter(key => !transactionHiddenColumns.has(key))
        : [];
      const hasAccountColumn = firstWithTransactions?.transactions?.some(tx => tx.accountCode);
      const hasSourceColumn = firstWithTransactions?.transactions?.some(tx => tx.source);
      // A small fixed palette, assigned per account code in first-seen order within one contact's
      // transaction list — same idea as Xenon's colored account pills, so a reader can tell at a
      // glance which lines share an account without reading every code.
      const ACCOUNT_BADGE_COLORS = ['#c0264a', '#b8860b', '#2f6f4e', '#3457a6', '#7d4f9a', '#a35c1e'];
      function accountBadgeColor(colorByCode, accountCode) {
        if (!colorByCode.has(accountCode)) {
          colorByCode.set(accountCode, ACCOUNT_BADGE_COLORS[colorByCode.size % ACCOUNT_BADGE_COLORS.length]);
        }
        return colorByCode.get(accountCode);
      }
      // Fixed (not rotating) — the transaction direction is a fixed category, not an arbitrary set
      // like account codes, so it always gets the same color regardless of what else is on the page.
      const SOURCE_BADGE = {
        bank_spend: { label: 'Money Out', color: '#7a1f2b' },
        bank_receive: { label: 'Money In', color: '#1e6b45' },
        bill: { label: 'Bill', color: '#4a4a4a' },
        invoice: { label: 'Invoice', color: '#4a4a4a' },
        credit_note: { label: 'Credit note', color: '#4a4a4a' },
      };
    %>
    <%
      // Unprocessed Bank can mix imported-statement lines and per-account rows from Xero's Bank accounts page,
      // which carry different fields, so its columns are every field any row has (not just the first row's).
      const columnSource = checkType === 'unprocessed_bank'
        ? [...new Set(tableRows.flatMap(row => Object.keys(row)))]
        : Object.keys(tableRows[0]);
      const columns = columnSource.filter(key => !hiddenColumns.has(key));
    %>
    <% const mainHasAccountColumn = tableRows.some(item => item.accountCode); %>
    <% const mainHasSourceColumn = tableRows.some(item => item.source); %>
    <% const mainHasAge = tableRows.some(item => item.ageDays != null); %>
    <% const mainColorByCode = new Map(); %>
    <% if (tableRows.some(isConvertedRow)) { %>
      <p class="check-note">Some documents are in another currency. Each is shown in its own currency with the amount converted to the client's currency beside it; the totals use the converted amounts.</p>
    <% } if (tableRows.some(isNoRateRow)) { %>
      <p class="check-note">Some documents in another currency have no exchange rate in the ledger. They are listed and counted, but their amounts are not included in the totals.</p>
    <% } if (tableRows.some(item => isOtherCurrency(item) && !isConvertedRow(item) && !isNoRateRow(item))) { %>
      <p class="check-note">Some documents are in another currency. Their amounts are shown in that currency, not converted.</p>
    <% } %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th><span class="sr-only">Select</span></th>
            <% if (mainHasSourceColumn) { %><th><span class="sr-only">Type</span></th><% } %>
            <% columns.forEach(key => { %>
              <th style="text-transform: capitalize;"><%= key.replace(/_/g,' ').replace(/([A-Z])/g,' $1').trim() %></th>
              <% if (key === 'date' && mainHasAge) { %><th>Age</th><% } %>
            <% }) %>
            <% if (mainHasAccountColumn) { %><th>Account Code Used</th><% } %>
            <th><%= /^zoho-/.test(String(org.freeagent_company_id || '')) ? 'Zoho Books' : 'Xero' %></th>
            <th>Review</th>
          </tr>
        </thead>
        <tbody>
          <% tableRows.forEach((item, rowIndex) => { %>
            <% if (item.lookback && (rowIndex === 0 || !tableRows[rowIndex - 1].lookback)) { %>
              <tr class="previous-months-heading">
                <td colspan="<%= columns.length + 3 + (mainHasSourceColumn ? 1 : 0) + (mainHasAccountColumn ? 1 : 0) + (mainHasAge ? 1 : 0) %>" style="background:#F2F6FA; font-weight:600; font-size:0.8rem; color:#4a5a73;">
                  <%= checkType === 'unreconciled_bank_items' ? 'Before the review period, still unreconciled: for context, not counted' : 'Previous 3 months, before the review period: for context, not counted' %> (<%= previousPage ? previousPage.total : previousRows.length %>)
                </td>
              </tr>
            <% } %>
            <tr <%- item.lookback ? 'class="previous-months-row" style="opacity:0.8;"' : (item.displayOnly ? 'class="display-only-row" style="display:none;"' : '') %>>
              <td>
                <input form="bulkReview" type="checkbox" name="finding_keys" value="<%= item.finding_key %>" aria-label="Select finding">
              </td>
              <% if (mainHasSourceColumn) { %>
                <td>
                  <% const mainBadge = SOURCE_BADGE[item.source]; %>
                  <% if (mainBadge) { %>
                    <span class="chip" style="background: <%= mainBadge.color %>; color: white;"><%= mainBadge.label %></span>
                  <% } else if (item.source) { %>
                    <span class="chip" style="background: #4a4a4a; color: white;"><%= item.source %></span>
                  <% } %>
                </td>
              <% } %>
              <% columns.forEach(key => { const val = item[key]; %>
                <td>
                  <% if (isMoneyCell(key, val)) { %>
                    <%= fmtMoney(val, rowPrefix(item)) %><% if (isConvertedRow(item)) { %> = <%= fmtMoney(item.baseAmount) %><% } else if (isNoRateRow(item)) { %> <span style="font-size:0.7rem;color:#7C8FAC;">(no exchange rate - not included in totals)</span><% } else if (isOtherCurrency(item)) { %> <span style="font-size:0.7rem;color:#7C8FAC;">(not converted)</span><% } %>
                  <% } else if (Array.isArray(val)) { %>
                    <%# A group of bills/invoices is listed as "reference · amount · status · date", never as [object Object] %>
                    <%= val.length && val[0] !== null && typeof val[0] === 'object'
                      ? val.map(d => [d.reference, d.amount != null ? rowPrefix(item) + Number(d.amount).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : null, d.status, fmtDisplayDate(d.date)].filter(Boolean).join(' · ')).join('   |   ')
                      : val.join(', ') %>
                  <% } else { %>
                    <%= val != null ? fmtDisplayDate(val) : '—' %>
                  <% } %>
                </td>
                <% if (key === 'date' && mainHasAge) { %>
                  <td><%= item.ageDays != null ? `${item.ageDays} day${item.ageDays !== 1 ? 's' : ''}` : '—' %></td>
                <% } %>
              <% }) %>
              <% if (mainHasAccountColumn) { %>
                <td>
                  <% if (item.accountCode) { %>
                    <span class="chip" style="background: <%= accountBadgeColor(mainColorByCode, item.accountCode) %>; color: white;">
                      <%= item.accountName ? `${item.accountCode} - ${item.accountName}` : item.accountCode %>
                    </span>
                  <% } else { %>—<% } %>
                </td>
              <% } %>
              <td>
                <% item.xero_links.forEach(link => { %>
                  <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a><br>
                <% }) %>
              </td>
              <td style="min-width:180px;">
                <span class="chip <%= item.review_state === 'active' ? 'chip-success' : 'chip-default' %>">
                  <%= item.review_state.replace('_', ' ') %><%= item.lookback ? ' · previous months, not counted' : (item.displayOnly ? ' · display only' : '') %>
                </span>
                <% if (item.ignored_until) { %>
                  <div class="text-muted">Until <%= new Date(item.ignored_until).toLocaleDateString('en-GB') %></div>
                <% } %>
                <% if (item.notes) { %><div class="text-muted"><%= item.notes %></div><% } %>
                <form method="post" action="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/review" style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
<% viewFields.forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
                  <input type="hidden" name="finding_key" value="<%= item.finding_key %>">
                  <input type="hidden" name="return_status" value="<%= status %>">
                  <input type="hidden" name="return_page" value="<%= pagination.page %>">
                  <% if (item.review_state === 'active') { %>
                    <button class="btn btn-sm btn-outlined" name="action" value="dismissed">Dismiss</button>
                    <button class="btn btn-sm btn-outlined" name="action" value="ignored">Ignore</button>
                    <button class="btn btn-sm btn-outlined" name="action" value="ok">OK</button>
                  <% } else { %>
                    <button class="btn btn-sm btn-primary" name="action" value="restore">Restore</button>
                  <% } %>
                </form>
                <% if (item.standaloneNote) { %><div class="text-muted" style="margin-top:4px;"><%= item.standaloneNote %></div><% } %>
                <form method="post" action="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/note" style="margin-top:4px;display:flex;gap:4px;flex-wrap:wrap;">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
<% viewFields.forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
                  <input type="hidden" name="finding_key" value="<%= item.finding_key %>">
                  <input type="hidden" name="return_status" value="<%= status %>">
                  <input type="hidden" name="return_page" value="<%= pagination.page %>">
                  <input type="text" name="notes" maxlength="500" placeholder="Note" value="<%= item.standaloneNote || '' %>" class="form-input" style="width:100px;font-size:0.75rem;">
                  <button class="btn btn-sm btn-outlined">Add Note</button>
                </form>
                <% const contactName = item.contact || item.name; %>
                <% if (contactName) { %>
                  <form method="post" action="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/ignore-contact" style="margin-top:4px;"
                    onsubmit="return confirm('Permanently ignore <%= contactName %> from this check? This applies from the next sync onward, for every finding on this contact.')">
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                    <input type="hidden" name="contact_name" value="<%= contactName %>">
                    <input type="hidden" name="return_status" value="<%= status %>">
                    <input type="hidden" name="return_page" value="<%= pagination.page %>">
                    <button class="btn btn-sm" style="color:#dc2626;background:none;border:none;padding:0;text-decoration:underline;cursor:pointer;">Ignore this contact</button>
                  </form>
                <% } %>
              </td>
            </tr>
            <% if (item.transactions && item.transactions.length) { %>
              <tr>
                <td colspan="<%= columns.length + 3 + (mainHasSourceColumn ? 1 : 0) + (mainHasAccountColumn ? 1 : 0) + (mainHasAge ? 1 : 0) %>" style="padding:0; border-top:none;">
                  <% const txGroups = groupSupplierTransactions(item.transactions); %>
                  <details style="margin: 0 0 8px 32px;">
                    <summary style="cursor:pointer; color:#5D87FF; font-size:0.8rem; padding:4px 0;">
                      Show <%= item.transactions.length %> transaction<%= item.transactions.length !== 1 ? 's' : '' %><%= txGroups.grouped ? ' (' + txGroups.groups.map(g => g.rows.length + ' ' + (g.key === 'period' ? 'in the period' : 'earlier')).join(', ') + ')' : '' %>
                    </summary>
                    <div class="table-wrap">
                      <table class="data-table" style="font-size:0.8rem;">
                        <thead>
                          <tr>
                            <% if (hasSourceColumn) { %><th><span class="sr-only">Type</span></th><% } %>
                            <% transactionColumns.forEach(key => { %>
                              <th style="text-transform: capitalize;"><%= key.replace(/_/g,' ').replace(/([A-Z])/g,' $1').trim() %></th>
                            <% }) %>
                            <% if (hasAccountColumn) { %><th>Account Code Used</th><% } %>
                            <th><%= /^zoho-/.test(String(org.freeagent_company_id || '')) ? 'Zoho Books' : 'Xero' %></th>
                            <th>Reviewed?</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% const colorByCode = new Map(); %>
                          <% txGroups.groups.forEach(group => { %>
                          <% if (txGroups.grouped) { %>
                            <tr class="tx-group-row">
                              <td colspan="<%= (hasSourceColumn ? 1 : 0) + transactionColumns.length + (hasAccountColumn ? 1 : 0) + 2 %>" style="background:#F2F6FA; font-weight:600; font-size:0.75rem; color:#4a5a73;">
                                <%= group.label %> (<%= group.rows.length %>)
                              </td>
                            </tr>
                          <% } %>
                          <% group.rows.forEach(tx => { %>
                            <tr>
                              <% if (hasSourceColumn) { %>
                                <td>
                                  <% const badge = SOURCE_BADGE[tx.source]; %>
                                  <% if (badge) { %>
                                    <span class="chip" style="background: <%= badge.color %>; color: white;"><%= badge.label %></span>
                                  <% } else if (tx.source) { %>
                                    <span class="chip" style="background: #4a4a4a; color: white;"><%= tx.source %></span>
                                  <% } %>
                                </td>
                              <% } %>
                              <% transactionColumns.forEach(key => { const val = tx[key]; %>
                                <td>
                                  <% if (isMoneyCell(key, val)) { %>
                                    <%= fmtMoney(val) %>
                                  <% } else { %>
                                    <%= val != null ? fmtDisplayDate(val) : '—' %>
                                  <% } %>
                                </td>
                              <% }) %>
                              <% if (hasAccountColumn) { %>
                                <td>
                                  <% if (tx.accountCode) { %>
                                    <span class="chip" style="background: <%= accountBadgeColor(colorByCode, tx.accountCode) %>; color: white;">
                                      <%= tx.accountName ? `${tx.accountCode} - ${tx.accountName}` : tx.accountCode %>
                                    </span>
                                  <% } else { %>—<% } %>
                                </td>
                              <% } %>
                              <td>
                                <% (tx.xero_links || []).forEach(link => { %>
                                  <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a><br>
                                <% }) %>
                              </td>
                              <td style="min-width:160px;">
                                <% if (tx.lineKey) { %>
                                  <span class="chip <%= tx.ok ? 'chip-success' : 'chip-default' %>">
                                    <%= tx.ok ? 'OK' : 'Unreviewed' %>
                                  </span>
                                  <% if (tx.notes) { %><div class="text-muted"><%= tx.notes %></div><% } %>
                                  <form method="post" action="<%= basePath %>/client/<%= orgIdentifier %>/check/<%= checkType %>/line-review" style="margin-top:4px;display:flex;gap:4px;flex-wrap:wrap;">
                                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                                    <input type="hidden" name="finding_key" value="<%= item.finding_key %>">
                                    <input type="hidden" name="line_key" value="<%= tx.lineKey %>">
                                    <input type="hidden" name="return_status" value="<%= status %>">
                                    <input type="hidden" name="return_page" value="<%= pagination.page %>">
                                    <input type="hidden" name="ok" value="<%= tx.ok ? '0' : '1' %>">
                                    <input type="text" name="notes" maxlength="500" placeholder="Note" value="<%= tx.notes || '' %>" class="form-input" style="width:90px;font-size:0.75rem;">
                                    <button class="btn btn-sm <%= tx.ok ? 'btn-outlined' : 'btn-primary' %>"><%= tx.ok ? 'Mark unreviewed' : 'Mark as OK' %></button>
                                  </form>
                                <% } else { %>
                                  —
                                <% } %>
                              </td>
                            </tr>
                          <% }) %>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </details>
                </td>
              </tr>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (previousPage && previousPage.totalPages > 1) { %>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 20px;">
        <span style="color:#7C8FAC; font-size:0.8rem;">
          Previous 3 months: page <%= previousPage.page %> of <%= previousPage.totalPages %> · <%= previousPage.total %> items
        </span>
        <div style="display:flex; gap:8px;">
          <% if (previousPage.page > 1) { %>
            <a class="btn btn-outlined btn-sm" href="?status=<%= status %>&page=<%= pagination.page %>&ppage=<%= previousPage.page - 1 %><%= contact ? '&contact=' + encodeURIComponent(contact) : '' %><%= viewAmp %>">Previous</a>
          <% } %>
          <% if (previousPage.page < previousPage.totalPages) { %>
            <a class="btn btn-outlined btn-sm" href="?status=<%= status %>&page=<%= pagination.page %>&ppage=<%= previousPage.page + 1 %><%= contact ? '&contact=' + encodeURIComponent(contact) : '' %><%= viewAmp %>">Next</a>
          <% } %>
        </div>
      </div>
    <% } %>
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px;">
        <span style="color:#7C8FAC; font-size:0.8rem;">
          Page <%= pagination.page %> of <%= pagination.totalPages %> · <%= pagination.total %> findings
        </span>
        <div style="display:flex; gap:8px;">
          <% if (pagination.page > 1) { %>
            <a class="btn btn-outlined btn-sm" href="?status=<%= status %>&page=<%= pagination.page - 1 %><%= contact ? '&contact=' + encodeURIComponent(contact) : '' %><%= viewAmp %>">Previous</a>
          <% } %>
          <% if (pagination.page < pagination.totalPages) { %>
            <a class="btn btn-outlined btn-sm" href="?status=<%= status %>&page=<%= pagination.page + 1 %><%= contact ? '&contact=' + encodeURIComponent(contact) : '' %><%= viewAmp %>">Next</a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>
<% } %>

<script>
function toggleSelectPage(btn) {
  const boxes = document.querySelectorAll('[name="finding_keys"]');
  const allChecked = Array.from(boxes).every(box => box.checked);
  boxes.forEach(box => { box.checked = !allChecked; });
  btn.textContent = allChecked ? 'Select page' : 'Unselect page';
}

function confirmBulkAll() {
  const select = document.getElementById('bulkAllSelect');
  const label = select.options[select.selectedIndex].text;
  return confirm('Apply "' + label + '"? This affects every matching item, not just this page.');
}
</script>

<%- include('partials/footer') %>
