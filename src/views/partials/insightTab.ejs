<%
/* ---- helpers ---- */
function fmtGbp(n, dp) {
  if (n == null || isNaN(n)) return '—';
  const neg = n < 0;
  dp = dp ?? 2;
  const abs = Math.abs(n).toLocaleString('en-GB', { minimumFractionDigits: dp, maximumFractionDigits: dp });
  return neg ? `(£${abs})` : `£${abs}`;
}
function fmtGbpPlain(n, dp) {
  if (n == null || isNaN(n)) return '—';
  dp = dp ?? 2;
  return `£${Math.abs(n).toLocaleString('en-GB', { minimumFractionDigits: dp, maximumFractionDigits: dp })}`;
}
function fmtGbpSigned(n, dp) {
  if (n == null || isNaN(n)) return '—';
  dp = dp ?? 0;
  const sign = n < 0 ? '-' : '';
  return `£${sign}${Math.abs(n).toLocaleString('en-GB', { minimumFractionDigits: dp, maximumFractionDigits: dp })}`;
}
const FULL_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
function fmtFyLabelFull(label) {
  // "31/03/2027" -> "31 March 2027" — matches Xenon's Corp Tax card descriptive text.
  const m = String(label || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if (!m) return label;
  return `${parseInt(m[1], 10)} ${FULL_MONTHS[parseInt(m[2], 10) - 1]} ${m[3]}`;
}
function shortMonth(label) {
  const m = String(label || '').match(/(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/i);
  return m ? m[1] : label;
}

const settingsUrl = `/client/${org.xero_tenant_id}/insight/settings`;
const pnl  = insight && insight.pnl   ? insight.pnl.data   : null;
const bs   = insight && insight.balance_sheet ? insight.balance_sheet.data : null;
const ctax = insight && insight.corp_tax ? insight.corp_tax.data : null;
const tgt  = insight && insight.target ? insight.target.data  : null;
const ctaxOverrides = insight && insight.corp_tax_overrides ? insight.corp_tax_overrides.data : {};

/* ---- health score from checkDefs ---- */
const BANK_TYPES = ['unreconciled_bank_items', 'bank_balance'];
const DUP_TYPES  = ['duplicate_invoices', 'duplicate_bills'];
const OLD_TYPES  = ['old_unpaid_invoices', 'old_sales_credits', 'old_unpaid_bills', 'old_purchase_credits'];
const sumTypes = types => checkDefs.reduce((s, c) => types.includes(c.type) ? s + (c.count || 0) : s, 0);
const bankCount  = sumTypes(BANK_TYPES);
const dupCount   = sumTypes(DUP_TYPES);
const oldCount   = sumTypes(OLD_TYPES);
const otherCount = checkDefs.reduce((s, c) => {
  if ([...BANK_TYPES, ...DUP_TYPES, ...OLD_TYPES].includes(c.type)) return s;
  return s + (c.count || 0);
}, 0);
const healthPct = Math.round(Math.max(0, Math.min(100, score ?? 100)));

/* ---- current month info ---- */
const now = new Date();
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const curMonthName = MONTHS[now.getMonth()];
const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
const daysRemaining = daysInMonth - now.getDate();

/* ---- current month sales ---- */
let curMonthSales = null;
if (pnl && pnl.headers && pnl.totalIncome) {
  const lastIdx = pnl.headers.length - 1;
  curMonthSales = pnl.totalIncome[lastIdx] || 0;
}
/* ---- sales target: basis-driven, matching the settings page's dropdown ---- */
const pctIncrease = (tgt && tgt.pct_increase) ? tgt.pct_increase / 100 : 0;
function avgOfLastN(n) {
  if (!pnl || !pnl.totalIncome || pnl.totalIncome.length < n) return null;
  const slice = pnl.totalIncome.slice(-n);
  return slice.reduce((a, b) => a + b, 0) / n;
}
let monthlyTarget = null;
const basis = tgt && tgt.basis;
if (basis === 'fixed' && tgt.monthly_target != null) {
  monthlyTarget = tgt.monthly_target;
} else if (basis === 'previous_month' && pnl && pnl.totalIncome && pnl.totalIncome.length >= 2) {
  monthlyTarget = pnl.totalIncome[pnl.totalIncome.length - 2];
} else if (basis === 'avg3') {
  monthlyTarget = avgOfLastN(3);
} else if (basis === 'avg6') {
  monthlyTarget = avgOfLastN(6);
} else if (basis === 'avg12') {
  monthlyTarget = avgOfLastN(12);
} else if (basis === 'same_month_last_year') {
  monthlyTarget = null; // needs 13+ months of history; not yet synced (trailing window is 12mo)
}
if (monthlyTarget != null) monthlyTarget = monthlyTarget * (1 + pctIncrease);

/* ---- cash health ---- */
// Xenon lists whichever current-liability lines are actually booked for this client (e.g. just
// "VAT" + "Corporation Tax"), not a fixed Suppliers/PAYE/Corp Tax trio — mirror that here.
const RELABEL = { 'VAT': 'VAT Bill' };
const cashBal        = bs ? (bs.cashAndBank || 0) : null;
const payItems       = bs ? (bs.liabilityLines || [])
  .map(l => ({ name: RELABEL[l.name] || l.name, val: Math.abs(l.value) }))
  .filter(l => l.val > 0) : [];
const totalOutgoing  = payItems.reduce((s, l) => s + l.val, 0);

/* ---- corp tax ---- */
const fyPeriods = ctax ? ctax.periods : [];
const fyDisplay = fyPeriods.map((p, i) => {
  const key = `fy${i}`;
  const override = ctaxOverrides[key];
  return {
    ...p,
    displayEstimate: override != null ? parseFloat(override) : p.estimate,
    hasOverride: override != null,
  };
});

/* ---- directors loans ---- */
const dirAccounts = bs ? (bs.directorAccounts || []) : [];
// Must match the anchor date insightSync used to fetch the "since" balance (fyPeriods[1].end),
// not a separately-computed date — otherwise the label and the figure can disagree.
const prevFyEndLabel = fyDisplay[1] ? fyDisplay[1].label : null;

/* ---- business valuation ---- */
const kv = typeof insightKv !== 'undefined' ? insightKv : {};
const valuationModel = kv.valuation_model || '';
const valuationMultiple = kv.valuation_multiple != null ? parseFloat(kv.valuation_multiple) : 1;
const VALUATION_MODEL_LABELS = {
  current_profit: 'Current Annual Profit (last 12 months)',
  current_sales: 'Current Annual Sales (last 12 months)',
  net_asset_value: 'Current Net Asset Value',
};
let valuationBase = null;
if (valuationModel === 'current_profit' && pnl && pnl.netProfit) {
  valuationBase = pnl.netProfit.reduce((a, b) => a + b, 0);
} else if (valuationModel === 'current_sales' && pnl && pnl.totalIncome) {
  valuationBase = pnl.totalIncome.reduce((a, b) => a + b, 0);
} else if (valuationModel === 'net_asset_value' && bs) {
  valuationBase = bs.totalEquity != null ? bs.totalEquity : null;
}
const valuationEstimate = valuationBase != null ? valuationBase * valuationMultiple : null;

/* ---- working capital ---- */
// Xenon shows 0 days (not a "no data" state) when the balance sheet has no trade debtor/
// creditor lines, so match that rather than defaulting to null.
const tradeDebtors   = bs && bs.tradeDebtors   != null ? Math.abs(bs.tradeDebtors)   : 0;
const tradeCreditors = bs && bs.tradeCreditors != null ? Math.abs(bs.tradeCreditors) : 0;
const avgRevPerDay   = (pnl && pnl.totalIncome) ? pnl.totalIncome.reduce((a,b)=>a+b,0)/365 : 0;
const debtorDays     = avgRevPerDay > 0 ? Math.round(tradeDebtors   / avgRevPerDay) : 0;
const stockDays      = 0;
const creditorDays   = avgRevPerDay > 0 ? Math.round(tradeCreditors / avgRevPerDay) : 0;
const workingCapDays = debtorDays + stockDays - creditorDays;

/* ---- dividend ---- */
const retainedEarnings  = bs ? (bs.retainedEarnings || bs.totalEquity || 0) : null;
const dividendsPaid     = bs ? Math.abs(bs.dividendsPaid || 0) : 0;
let   dividendAvailable = retainedEarnings || 0;
for (const fy of fyDisplay) dividendAvailable -= fy.displayEstimate;
dividendAvailable -= dividendsPaid;

/* ---- recent cash movements (last 4 months) ---- */
// Net bank movement (closing minus opening balance) from the Bank Summary report — a different,
// more accurate figure than P&L sales/income, which is what the Sales Tracker card shows instead.
const cashMovementsData = insight && insight.cash_movements ? insight.cash_movements.data : null;
const recentMonths = cashMovementsData && cashMovementsData.months
  ? cashMovementsData.months.filter(m => m.netMovement != null).map(m => ({ label: m.label, value: m.netMovement })).reverse()
  : [];

const hasAnyData = !!(pnl || bs || ctax);
%>

<style>
:root {
