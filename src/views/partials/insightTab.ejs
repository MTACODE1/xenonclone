  <div class="i-card-head">
    <span class="i-card-title">Business Valuation</span>
    <span class="i-card-icons"><a class="i-gear" href="<%= basePath %><%= settingsUrl %>" title="Insight settings" aria-label="Insight settings"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></a></span>
  </div>
  <div class="i-card-body">
    <% if (!valuationModel) { %>
    <div class="chart-empty">No valuation model has been chosen for this client yet. Choose one (annual profit, annual sales or net asset value, times a multiple) to see an estimate here.</div>
    <% } else if (valuationEstimate == null) { %>
    <div class="chart-empty">Not enough synced data for <%= VALUATION_MODEL_LABELS[valuationModel] %> yet.</div>
    <% } else { %>
    <div class="stat-label">Valuation estimate</div>
    <div class="stat-value is-accent"><%= fmtGbpPlain(valuationEstimate, 0) %></div>
    <div class="stat-sub"><%= VALUATION_MODEL_LABELS[valuationModel] %> × <%= valuationMultiple %></div>
    <% } %>
    <div class="i-card-foot"><a href="<%= basePath %><%= settingsUrl %>#business-valuation" class="btn-outline-teal"><%= valuationModel ? 'Edit valuation model' : 'Choose valuation model' %></a></div>
  </div>
</div>

<!-- 7. WORKING CAPITAL CYCLE -->
<div class="i-card">
  <div class="i-card-head">
    <span class="i-card-title">Working Capital Cycle</span>
    <span class="i-card-icons"><a class="i-gear" href="<%= basePath %><%= settingsUrl %>#working-capital" title="Insight settings" aria-label="Insight settings"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></a></span>
  </div>
  <div class="i-card-body">
    <div class="stat-label">Cash conversion</div>
    <div class="stat-value is-accent"><%= workingCapDays %> day<%= workingCapDays === 1 ? '' : 's' %></div>
    <div class="wc-summary">to turn the business' cash outflows into cash inflows.</div>
    <div class="wc-tiles">
      <div class="wc-tile"><div class="wc-tile-val"><%= debtorDays %></div><div class="wc-tile-lbl">Debtor days</div></div>
      <div class="wc-tile"><div class="wc-tile-val"><%= stockDays %></div><div class="wc-tile-lbl">Stock days</div></div>
      <div class="wc-tile"><div class="wc-tile-val"><%= creditorDays %></div><div class="wc-tile-lbl">Creditor days</div></div>
    </div>
    <div class="wc-formula">Debtor days + stock days − creditor days<% if (!debtorDays && !creditorDays) { %>. No trade debtors or creditors are mapped or outstanding, so this is 0.<% } %></div>
  </div>
</div>

<!-- 8. DIVIDEND AVAILABILITY -->
<div class="i-card">
  <div class="i-card-head">
    <span class="i-card-title">Dividend Availability</span>
    <span class="i-card-icons"><a class="i-gear" href="<%= basePath %><%= settingsUrl %>#dividend" title="Insight settings" aria-label="Insight settings"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></a></span>
  </div>
  <div class="i-card-body">
    <div>
      <div class="div-row">
        <span class="div-row-label">Current profit reserves (per balance sheet)</span>
        <span class="div-row-val"><%= retainedEarnings != null ? fmtGbpPlain(retainedEarnings, 2) : '—' %></span>
      </div>
      <% // Xenon lists oldest FY first, current FY last — reverse fyDisplay (which is newest-first)
         // for display while keeping each row's original index for the edit button/override key. %>
      <% for (let i = fyDisplay.length - 1; i >= 0; i--) { const fy = fyDisplay[i]; %>
      <div class="div-row">
        <span class="div-row-label">Less corporation tax estimate (y.e. <%= fy.label %>)</span>
        <span style="display:flex;align-items:center;gap:4px;">
          <span class="div-row-val deduction"><%= fmtGbp(fy.displayEstimate, 2) %></span>
          <button class="div-row-edit" onclick="openCtaxEdit(<%= i %>, '<%= fy.label %>', <%= fy.displayEstimate.toFixed(2) %>)" title="Override this estimate">Edit</button>
        </span>
      </div>
      <% } %>
      <% if (dividendsPaid > 0) { %>
      <div class="div-row">
        <span class="div-row-label">Less dividends already paid</span>
        <span class="div-row-val deduction"><%= fmtGbp(dividendsPaid, 2) %></span>
      </div>
      <% } %>
      <div class="div-divider"></div>
      <div class="div-total-row">
        <span>Maximum dividend available</span>
        <span class="div-total-val"><%= fmtGbpPlain(Math.max(0, dividendAvailable), 2) %></span>
      </div>
    </div>
    <div class="i-card-foot"><a href="https://www.gov.uk/guidance/dividends-paid-on-or-after-6-april-1999-what-they-are" target="_blank" rel="noopener" class="btn-outline-teal">View HMRC guidance</a></div>
  </div>
</div>

</div><!-- /insight-grid -->

<!-- Corp Tax Edit Modal -->
<div class="ctax-edit-modal" id="ctaxEditModal">
  <div class="ctax-edit-box">
    <h4>Override Corp Tax Estimate</h4>
    <form id="ctaxEditForm" method="POST" action="<%= basePath %>/client/<%= org.xero_tenant_id %>/insight/ctax-override">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="fy_index" id="editFyIndex">
      <label id="editFyLabel">Financial Year</label>
      <input type="number" name="estimate" id="editEstimate" step="0.01" min="0" placeholder="Enter corp tax estimate £">
      <div class="ctax-edit-btns">
        <button type="button" class="ctax-edit-cancel" onclick="closeCtaxEdit()">Cancel</button>
        <button type="submit" class="ctax-edit-save">Save</button>
      </div>
    </form>
  </div>
</div>

<% } %><!-- /hasAnyData -->
</div><!-- /insight-wrap -->

<script>
(function() {
  const D = {
    pnl:       <%- JSON.stringify(pnl)       %>,
    bs:        <%- JSON.stringify(bs)        %>,
    fyDisplay: <%- JSON.stringify(fyDisplay) %>,
    healthPct: <%= healthPct %>,
    cashBal:   <%- cashBal != null ? cashBal : 'null' %>,
    totalOut:  <%= totalOutgoing %>,
    wc: {
      days: <%- workingCapDays != null ? workingCapDays : 'null' %>,
      debtor: <%- debtorDays != null ? debtorDays : 'null' %>,
      stock: <%- stockDays != null ? stockDays : 'null' %>,
      creditor: <%- creditorDays != null ? creditorDays : 'null' %>,
    },
  };

  function fmtK(n) {
    if (n == null) return '—';
    const abs = Math.abs(n);
    if (abs >= 1000) return (n < 0 ? '-' : '') + '£' + (abs / 1000).toFixed(0) + 'k';
    return (n < 0 ? '-' : '') + '£' + Math.round(abs);
  }

  // Akrio Verify's palette: primary blue, green for good, amber for caution, red for bad.
  const TEAL  = '#5D87FF', TEAL_A = 'rgba(93,135,255,0.10)';
  const BLUE  = '#C3D2FF', BLUE_A = 'rgba(93,135,255,0.06)';
  const GREEN = '#13B89A', GREEN_A= 'rgba(19,184,154,0.10)';
  const AMBER = '#FFAE1F', RED    = '#F04438';
  if (window.Chart && Chart.defaults) { Chart.defaults.font.family = getComputedStyle(document.body).fontFamily; Chart.defaults.color = '#7C8FAC'; }
  const charts = {};
  // The tab can be opened more than once; a canvas can only hold one chart.
  const draw = (id, config) => { const c = document.getElementById(id); if (!c) return; if (charts[id]) charts[id].destroy(); charts[id] = new Chart(c, config); };

  function donut(id, pct, color) {
    draw(id, {
      type: 'doughnut',
      data: { datasets: [{ data: [pct, 100 - pct], backgroundColor: [color, '#EEF1F6'], borderWidth: 0, borderRadius: pct > 0 && pct < 100 ? 6 : 0 }] },
      options: { cutout: '78%', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, animation: false },
    });
  }

  function renderInsightCharts() {
    /* 1. Sales bar — trailing 5 months only, matching Xenon */
    if (D.pnl) {
      const allLabels = (D.pnl.headers || []).map(h => { const m = String(h).match(/(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[\s-]?(\d{2})?/i); return m ? (m[1] + (m[2] ? '-' + m[2] : '')) : h; });
      const allVals   = D.pnl.totalIncome || [];
      const labels = allLabels.slice(-5);
      const vals   = allVals.slice(-5);
      draw('chartSales', {
        type: 'bar',
        data: { labels, datasets: [{ label: 'Sales', data: vals, backgroundColor: vals.map((_, i) => i === vals.length - 1 ? TEAL : BLUE), borderRadius: 6, maxBarThickness: 44 }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => '£' + ctx.parsed.y.toLocaleString('en-GB', {minimumFractionDigits:0}) } } },
          scales: { x: { grid: { display: false }, ticks: { font: { size: 10 } } }, y: { ticks: { callback: fmtK, font: { size: 10 } }, grid: { color: '#F2F6FA' }, border: { display: false } } },
        },
      });
    }

    /* 2. Cash donut */
    const cashPct = D.cashBal != null && D.totalOut > 0 ? Math.max(1, Math.min(100, Math.round(D.cashBal / D.totalOut * 100))) : (D.cashBal != null ? 100 : 0);
    const cashCol = cashPct >= 100 ? GREEN : (cashPct >= 50 ? AMBER : RED);
    donut('chartCash', cashPct, cashCol);
    const lbl = document.getElementById('cashPctLabel');
    if (lbl) lbl.textContent = cashPct + '%';

    /* 3. Health donut */
    const hp = D.healthPct;
    donut('chartHealth', hp, hp >= 80 ? GREEN : hp >= 50 ? AMBER : RED);

    /* 4. Profitability area */
    const pc = document.getElementById('chartProfit');
    if (pc && D.pnl) {
      const allLabels = (D.pnl.headers || []).map(h => { const m = String(h).match(/(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[\s-]?(\d{2})?/i); return m ? (m[1] + (m[2] ? '-' + m[2] : '')) : h; });
      const labels = allLabels.slice(-7);
      draw('chartProfit', {
        type: 'line',
        data: {
          labels,
          datasets: [
            { label: 'Sales income', data: (D.pnl.totalIncome || []).slice(-7), borderColor: TEAL, backgroundColor: TEAL_A, fill: true, tension: 0.3, pointRadius: 3, borderWidth: 2 },
            { label: 'Gross profit', data: (D.pnl.grossProfit || []).slice(-7), borderColor: AMBER, backgroundColor: 'transparent', fill: false, tension: 0.3, pointRadius: 3, borderWidth: 2 },
            { label: 'Net profit (before tax)', data: (D.pnl.netProfit || []).slice(-7), borderColor: GREEN, backgroundColor: GREEN_A, fill: true, tension: 0.3, pointRadius: 3, borderWidth: 2 },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom', labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, pointStyle: 'circle', padding: 14, font: { size: 11 } } }, tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': £' + ctx.parsed.y.toLocaleString('en-GB', {minimumFractionDigits:0}) } } },
          scales: { x: { grid: { display: false }, ticks: { font: { size: 10 } } }, y: { ticks: { callback: fmtK, font: { size: 10 } }, grid: { color: '#F2F6FA' }, border: { display: false } } },
        },
      });
    }

    /* 5. Corp Tax bar */
    const cc = document.getElementById('chartCorpTax');
    if (cc && D.fyDisplay && D.fyDisplay.length) {
      const rev = [...D.fyDisplay].reverse();
      const SHORT_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const shortFyLabel = label => {
        const m = String(label || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        return m ? `${parseInt(m[1],10)} ${SHORT_MONTHS[parseInt(m[2],10)-1]} ${m[3]}` : label;
      };
      draw('chartCorpTax', {
        type: 'bar',
        data: { labels: rev.map(f => shortFyLabel(f.label)), datasets: [{ data: rev.map(f => f.displayEstimate || 0), backgroundColor: rev.map((_, i) => i === rev.length - 1 ? TEAL : BLUE), borderRadius: 6, maxBarThickness: 56 }] },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => '£' + ctx.parsed.y.toLocaleString('en-GB', {minimumFractionDigits:2}) } } },
          scales: { x: { grid: { display: false }, ticks: { font: { size: 10 } } }, y: { ticks: { callback: fmtK, font: { size: 10 } }, grid: { color: '#F2F6FA' }, border: { display: false } } },
        },
      });
    }

  }

  window.renderInsightCharts = renderInsightCharts;

  window.openCtaxEdit = function(idx, label, current) {
    document.getElementById('editFyIndex').value = idx;
    document.getElementById('editFyLabel').textContent = 'Financial Year ending ' + label;
    document.getElementById('editEstimate').value = current;
    document.getElementById('ctaxEditModal').classList.add('open');
  };
  window.closeCtaxEdit = function() { document.getElementById('ctaxEditModal').classList.remove('open'); };

  const modal = document.getElementById('ctaxEditModal');
  if (modal) modal.addEventListener('click', function(e) { if (e.target === this) window.closeCtaxEdit(); });
})();
</script>
