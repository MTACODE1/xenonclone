<div class="insight-wrap">
<% if (org.xero_tenant_id) { %>
<div class="insight-toolbar">
  <label for="insightToDate">Show data up to</label>
  <input type="date" id="insightToDate" value="<%= shownDate || todayIso %>" max="<%= todayIso %>" min="2000-01-01">
  <button type="button" id="insightToApply" class="btn-outline-teal" style="margin-top:0;">Show</button>
  <% if (shownDate) { %><a href="?panel=insight">Back to latest</a><% } %>
  <% if (shownDate && hasAnyData) { %><button type="button" id="insightRefetch" class="btn-outline-teal" style="margin-top:0;" title="Fetch this date's figures from Xero again">Fetch again</button><% } %>
  <span id="insightToNote" class="insight-note"><% if (shownDate && hasAnyData) { %>Figures as at <%= shownDate.split('-').reverse().join('/') %><% if (insight.meta && insight.meta.data && insight.meta.data.errors && insight.meta.data.errors.length) { %> (some reports could not be fetched)<% } %><% } else if (!shownDate && hasAnyData) { %>Latest figures, from the last sync<% } %></span>
</div>
<script>
(function () {
  var input = document.getElementById('insightToDate');
  var go = function () {
    if (!input.value) return;
    if (input.value > input.max) { alert('The date cannot be in the future.'); return; }
    window.location.search = '?panel=insight&insight_to=' + encodeURIComponent(input.value);
  };
  document.getElementById('insightToApply').addEventListener('click', go);
  input.addEventListener('keydown', function (event) { if (event.key === 'Enter') go(); });
  // Fetches the figures as at one date from Xero's reports (queued like a sync), then reloads the page.
  window.akrioInsightFetch = async function (date, btn) {
    var label = btn.textContent;
    var fail = function (message) { btn.disabled = false; btn.textContent = label === 'Fetching from Xero…' ? 'Try again' : label; alert('The figures could not be fetched: ' + message); };
    btn.disabled = true; btn.textContent = 'Fetching from Xero…';
    try {
      var resp = await fetch('<%= basePath %>/client/<%= org.xero_tenant_id %>/insight/fetch?date=' + encodeURIComponent(date), { method: 'POST', headers: { 'x-csrf-token': '<%= csrfToken %>' } });
      var data = await resp.json();
      if (!data.jobId) return fail(data.error || 'unknown error');
      var stream = new EventSource('<%= basePath %>/sync-jobs/' + encodeURIComponent(data.jobId) + '/events');
      stream.onmessage = function (event) {
        var job = JSON.parse(event.data);
        if (job.progress && job.progress.message) btn.textContent = job.progress.message;
        if (job.status === 'succeeded') { stream.close(); window.location.reload(); }
        else if (job.status === 'failed') { stream.close(); fail(job.error || 'Xero did not return the reports'); }
      };
      stream.onerror = function () { stream.close(); fail('the connection was lost; reload the page to check'); };
    } catch (error) { fail(error.message); }
  };
  var again = document.getElementById('insightRefetch');
  if (again) again.addEventListener('click', function () { window.akrioInsightFetch('<%= shownDate || '' %>', again); });
})();
</script>
<% } %>
<% if (shownDate && !hasAnyData) { %>
<div class="insight-no-data">
  <h3>Getting the figures as at <%= shownDate.split('-').reverse().join('/') %></h3>
  <p>These are fetched from Xero's reports (Profit &amp; Loss, Bank Summary, Balance Sheet). It takes about half a minute and does not change the health checks or the latest Insight figures.</p>
  <button type="button" id="insightFetchBtn" class="btn-outline-teal" style="margin-top:12px;" disabled>Fetching from Xero…</button>
</div>
<script>
window.addEventListener('load', function () {
  var btn = document.getElementById('insightFetchBtn');
  btn.onclick = function () { window.akrioInsightFetch('<%= shownDate %>', btn); };
  window.akrioInsightFetch('<%= shownDate %>', btn);
});
</script>
