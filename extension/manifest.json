{
  "manifest_version": 3,
  "name": "Akrio Verify - Xero bank feed reader",
  "version": "1.3.0",
  "description": "Reads the items to reconcile, bank balances and unreconciled statement lines shown on Xero's bank pages, when asked from Akrio Verify. Read-only.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["scripting"],
  "host_permissions": ["https://go.xero.com/*", "https://login.xero.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://wf.morethanaccountants.co.uk/akrio-verify/*"
      ],
      "js": ["verify-content.js"],
      "run_at": "document_idle"
    }
  ]
}
