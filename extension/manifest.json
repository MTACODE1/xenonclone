{
  "manifest_version": 3,
  "name": "Akrio Verify - Xero bank feed reader",
  "version": "1.0.0",
  "description": "Reads the items to reconcile and bank balances shown on Xero's Bank accounts page, when asked from Akrio Verify. Read-only.",
  "permissions": ["scripting"],
  "host_permissions": ["https://go.xero.com/*", "https://login.xero.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://wf.morethanaccountants.co.uk/akrio-verify/*",
        "http://localhost:3000/*",
        "https://localhost:3000/*"
      ],
      "js": ["verify-content.js"],
      "run_at": "document_idle"
    }
  ]
}
