{
  "manifest_version": 3,
  "name": "Akrio Verify - Xero and Zoho Books bank feed reader",
  "version": "1.5.1",
  "description": "Reads the bank figures shown on Xero's bank pages and on Zoho Books' Banking page, when asked from Akrio Verify. Read-only.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Akrio Verify" },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://go.xero.com/*", "https://login.xero.com/*"],
  "optional_host_permissions": [
    "https://books.zoho.com/*",
    "https://books.zoho.eu/*",
    "https://books.zoho.in/*",
    "https://books.zoho.com.au/*",
    "https://books.zoho.jp/*",
    "https://books.zoho.sa/*",
    "https://books.zoho.uk/*",
    "https://books.zoho.ae/*",
    "https://books.zoho.com.cn/*",
    "https://books.zohocloud.ca/*",
    "https://accounts.zoho.com/*",
    "https://accounts.zoho.eu/*",
    "https://accounts.zoho.in/*",
    "https://accounts.zoho.com.au/*",
    "https://accounts.zoho.jp/*",
    "https://accounts.zoho.sa/*",
    "https://accounts.zoho.uk/*",
    "https://accounts.zoho.ae/*",
    "https://accounts.zoho.com.cn/*",
    "https://accounts.zohocloud.ca/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://wf.morethanaccountants.co.uk/akrio-verify/*"
      ],
      "js": ["verify-content.js"],
      "run_at": "document_idle"
    }
  ]
}
